<section class="pakyuet-baked-hero ir-bhero">
  <div class="ir-bhero__carousel" data-hero-carousel>
    {%- for block in section.blocks -%}
      {%- liquid
        assign slide_link = block.settings.link
        if slide_link == blank
          assign slide_link = '/pages/shop'
        endif
        if block.settings.image_desktop != blank
          assign d_img = block.settings.image_desktop | image_url: width: 2200
        elsif block.settings.asset_desktop != blank
          assign d_img = block.settings.asset_desktop | asset_url
        else
          assign d_img = 'baked-' | append: forloop.index | append: '-desktop.jpg' | asset_url
        endif
        if block.settings.image_mobile != blank
          assign m_img = block.settings.image_mobile | image_url: width: 1200
        elsif block.settings.asset_mobile != blank
          assign m_img = block.settings.asset_mobile | asset_url
        else
          assign m_img = 'baked-' | append: forloop.index | append: '-mobile.jpg' | asset_url
        endif
        assign slide_alt = block.settings.alt | default: 'PAKYUET'
      -%}
      <a
        href="{{ slide_link }}"
        class="ir-bhero__slide{% if forloop.first %} active{% endif %}"
        data-hero-slide
        {{ block.shopify_attributes }}
        aria-label="{{ slide_alt | escape }}"
      >
        <img
          src="{{ d_img }}"
          alt="{{ slide_alt | escape }}"
          class="ir-bhero__img ir-bhero__img--desktop"
          width="2048"
          height="1152"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          {% if forloop.first %}fetchpriority="high"{% endif %}
          decoding="async"
        >
        <img
          src="{{ m_img }}"
          alt="{{ slide_alt | escape }}"
          class="ir-bhero__img ir-bhero__img--mobile"
          width="1080"
          height="1624"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          decoding="async"
        >
      </a>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="ir-bhero__prev" data-hero-prev aria-label="{% if localization.language.iso_code == 'en' %}Previous slide{% else %}上一張{% endif %}">&#8249;</button>
      <button type="button" class="ir-bhero__next" data-hero-next aria-label="{% if localization.language.iso_code == 'en' %}Next slide{% else %}下一張{% endif %}">&#8250;</button>
      <div class="ir-bhero__dots" data-hero-dots>
        {%- for block in section.blocks -%}
          <button type="button" class="ir-bhero__dot{% if forloop.first %} active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="{% if localization.language.iso_code == 'en' %}Slide {{ forloop.index }}{% else %}第 {{ forloop.index }} 張{% endif %}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PAKYUET 烤圖首頁輪播",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "輪播頁",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "桌面圖 (16:9)", "info": "未選取時使用 asset_desktop 或內建 baked-N-desktop.jpg" },
        { "type": "image_picker", "id": "image_mobile", "label": "手機圖 (9:16)", "info": "未選取時使用 asset_mobile 或內建 baked-N-mobile.jpg" },
        { "type": "text", "id": "asset_desktop", "label": "桌面圖 asset 檔名", "info": "如 baked-3-consult-desktop.jpg（theme assets 內檔案；Cloudflare 緩存 1 年，換圖必須換新檔名）" },
        { "type": "text", "id": "asset_mobile", "label": "手機圖 asset 檔名", "info": "如 baked-3-consult-mobile.jpg" },
        { "type": "url", "id": "link", "label": "整頁連結", "info": "點擊整張烤圖進入；留空則指向原首頁 /pages/shop" },
        { "type": "text", "id": "alt", "label": "替代文字", "default": "PAKYUET" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PAKYUET 烤圖首頁輪播",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
