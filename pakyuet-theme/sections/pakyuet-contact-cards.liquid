<section class="pakyuet-contact-cards ir-contact-cards">
  <div class="ir-contact-cards__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="ir-sec-head">
        {%- assign head_out = section.settings.heading -%}
        {%- if localization.language.iso_code == 'en' -%}
          {%- case head_out -%}
            {%- when '聯絡我們' -%}{%- assign head_out = 'Contact Us' -%}
          {%- endcase -%}
        {%- endif -%}
        <h2 class="ir-sec-head__title">{{ head_out }}</h2>
        {%- if section.settings.subheading != blank -%}
          {%- assign sub_out = section.settings.subheading -%}
          {%- if localization.language.iso_code == 'en' -%}
            {%- case sub_out -%}
              {%- when '歡迎透過以下方式聯繫我們，專人為您服務' -%}{%- assign sub_out = 'Reach us through any of the channels below — our team is here to help' -%}
            {%- endcase -%}
          {%- endif -%}
          <p class="ir-sec-head__sub">{{ sub_out }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="ir-contact-cards__grid">
      {%- for block in section.blocks -%}
        <div class="ir-contact-card" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h4 class="ir-contact-card__title">
              {%- if block.settings.icon != blank -%}
                <span class="ir-contact-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- assign title_out = block.settings.title -%}
              {%- if localization.language.iso_code == 'en' -%}
                {%- case title_out -%}
                  {%- when 'WhatsApp 專人客服' -%}{%- assign title_out = 'WhatsApp Customer Service' -%}
                  {%- when '客服郵箱' -%}{%- assign title_out = 'Customer Service Email' -%}
                  {%- when '公司資訊' -%}{%- assign title_out = 'Company Information' -%}
                {%- endcase -%}
              {%- endif -%}
              {{ title_out }}
            </h4>
          {%- endif -%}
          <div class="ir-contact-card__rows">
            {%- assign c_lines = block.settings.rows | default: '' | split: "
" -%}
            {%- for line in c_lines -%}
              {%- assign line_s = line | strip -%}
              {%- if line_s == blank -%}{%- continue -%}{%- endif -%}
              {%- assign parts = line_s | split: '|' -%}
              {%- assign r_txt = parts[0] | strip -%}
              {%- assign r_url = parts[1] | default: '' | strip -%}
              {%- if localization.language.iso_code == 'en' -%}
                {%- case r_txt -%}
                  {%- when '週一至週日 11:00 - 21:00' -%}{%- assign r_txt = 'Mon-Sun 11:00-21:00' -%}
                  {%- when '立即對話 →' -%}{%- assign r_txt = 'Chat now →' -%}
                  {%- when '發送郵件 →' -%}{%- assign r_txt = 'Send email →' -%}
                  {%- when '追蹤我們 →' -%}{%- assign r_txt = 'Follow us →' -%}
                {%- endcase -%}
              {%- endif -%}
              <p class="ir-contact-card__row">
                {%- if r_url != blank -%}
                  <a href="{{ r_url }}" class="ir-contact-card__link">{{ r_txt }}</a>
                {%- else -%}
                  {{ r_txt }}
                {%- endif -%}
              </p>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PAKYUET 聯絡我們卡",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "區塊標題", "default": "聯絡我們" },
    { "type": "text", "id": "subheading", "label": "副標題", "default": "歡迎透過以下方式聯繫我們，專人為您服務" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "聯絡卡片",
      "settings": [
        { "type": "text", "id": "icon", "label": "圖示 (emoji/文字)", "default": "💬" },
        { "type": "text", "id": "title", "label": "標題", "default": "WhatsApp 專人客服" },
        { "type": "textarea", "id": "rows", "label": "內容行 (每行「文字|連結」)", "default": "+852 9711 2975\n週一至週日 11:00 - 21:00\n立即對話 →|https://wa.me/85297112975" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PAKYUET 聯絡我們卡",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
