{%- comment -%}
  pakyuet-product-accordion
  参考 pakyuet-design/pages/product.html 第 5 节 "Product Accordion Tabs"
  - 细横线分隔,左标题 + 右 chevron,首项默认展开
  - 每行可選內容來源:產品描述({{ product.description }})/ 自定義richtext
    → 解决"商品詳情"与立即购买下方 description 重复:第一行绑 product.description,改一處两處同步
{%- endcomment -%}

<section
  class="pakyuet-accordion"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pakyuet-accordion__container">
    {%- for block in section.blocks -%}
      {%- assign is_open = false -%}
      {%- assign heading_out = block.settings.heading -%}
      {%- assign content_out = block.settings.content -%}
      {%- comment -%}
        i18n: 固定在设置里的中文文案（配送及退換 / 材質與保養）不走主题翻译界面，
        直接在渲染处按语言切换英文；默认中文站保持 block.settings 原文。
      {%- endcomment -%}
      {%- if localization.language.iso_code == 'en' -%}
        {%- case block.settings.heading -%}
          {%- when '商品詳情' -%}
            {%- assign heading_out = 'Details' -%}
          {%- when '配送及退換' -%}
            {%- assign heading_out = 'Shipping & Returns' -%}
            {%- assign content_out = "<ul><li>Order processing time: 1-3 business days</li><li>Hong Kong / Taiwan / Singapore: approx. 5-10 business days</li><li>Other regions: approx. 7-15 business days</li><li>Free shipping applies to orders over a specified amount; otherwise shipping is calculated at checkout.</li><li>You'll receive a tracking notification once your order ships.</li></ul><p><strong>Return policy:</strong></p><ul><li>Returns are generally not accepted.</li><li>Only items with obvious defects or shipping errors are eligible, and you must contact us within 48 hours of receipt.</li></ul>" -%}
          {%- when '材質與保養' -%}
            {%- assign heading_out = 'Material & Care' -%}
            {%- assign content_out = "<p>S925 sterling silver contains 92.5% pure silver. Precision-polished after high-temperature forging, it delivers a warm, skin-friendly finish. With a hardness of 9.25 on the Mohs scale — close to diamond's 10 — moissanite offers excellent durability and refractive brilliance.</p><p><strong>Care tips:</strong></p><ul><li>Avoid contact with chemicals (perfume, cleaning agents, etc.)</li><li>Remove before swimming or bathing</li><li>Polish with the included silver cloth to keep it shining</li><li>Store in a sealed bag or jewelry box when not worn</li></ul>" -%}
        {%- endcase -%}
      {%- endif -%}
      {%- if forloop.first and section.settings.open_first -%}{%- assign is_open = true -%}{%- endif -%}
      {%- if block.settings.open_default -%}{%- assign is_open = true -%}{%- endif -%}

      <div
        class="pakyuet-accordion__item{% if is_open %} is-open{% endif %}"
        {{ block.shopify_attributes }}
      >
        <button
          type="button"
          class="pakyuet-accordion__header"
          aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
        >
          <span>{{ heading_out }}</span>
          <svg class="pakyuet-accordion__chevron" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="pakyuet-accordion__body">
          <div class="pakyuet-accordion__inner">
            {%- if block.settings.source == 'product_description' -%}
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                {{ content_out }}
              {%- endif -%}
            {%- else -%}
              {{ content_out }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.pakyuet-accordion__item').forEach(function (item) {
      var header = item.querySelector('.pakyuet-accordion__header');
      if (!header) return;
      header.addEventListener('click', function () {
        var isOpen = item.classList.toggle('is-open');
        header.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "產品手風琴",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "open_first",
      "default": true,
      "label": "預設展開第一項"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "頂部間距",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "底部間距",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "折叠行",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "標題",
          "default": "商品詳情"
        },
        {
          "type": "select",
          "id": "source",
          "label": "內容來源",
          "options": [
            { "value": "product_description", "label": "產品描述(與購買按鈕下方同步)" },
            { "value": "custom", "label": "自定義內容" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "自定義內容(來源=自定義時,或產品描述為空時顯示)",
          "default": "<p>請輸入內容。</p>"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "default": false,
          "label": "此項預設展開"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "產品手風琴",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "商品詳情",
            "source": "product_description"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "配送及退換",
            "source": "custom",
            "content": "<ul><li>訂單處理時間:1-3 個工作天</li><li>香港 / 台灣 / 新加坡:約 5-10 個工作天</li><li>其他地區:約 7-15 個工作天</li><li>滿指定金額可享免運,未達門檻於結帳時顯示運費</li><li>訂單發出後將收到物流追蹤通知</li></ul><p><strong>退換政策:</strong></p><ul><li>一般情況不接受退貨或退款</li><li>僅限商品明顯瑕疵或寄送錯誤,並於收貨後 48 小時內聯絡我們</li></ul>"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "材質與保養",
            "source": "custom",
            "content": "<p>S925 純銀含銀量 92.5%,質感溫潤親膚。莫桑石硬度達 9.25(莫氏硬度),接近鑽石的 10,火彩璀璨持久。</p><p><strong>保養建議:</strong></p><ul><li>避免接觸化學品(香水、清潔劑等)</li><li>游泳或洗澡時請摘下</li><li>使用隨附擦銀布擦拭,保持光澤</li><li>不佩戴時,請存放於密封袋或首飾盒中</li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
