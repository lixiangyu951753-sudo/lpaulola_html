{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'pakyuet-reviews-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pool = shop.metafields.reviews.pool.value
  assign has_pool = false
  if pool != blank and pool.reviews.size > 0
    assign has_pool = true
  endif
  assign rating_decimal = 0
  if pool != blank and pool.avg != blank
    assign decimal = pool.avg | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  endif
-%}

<div class="pakyuet-reviews section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="pakyuet-reviews__header">
        <h2 class="pakyuet-reviews__heading">{{ section.settings.heading }}</h2>
        {%- if has_pool -%}
          <p class="pakyuet-reviews__summary">
            <span
              class="rating-star pakyuet-reviews__stars"
              style="--rating: {{ pool.avg | floor }}; --rating-max: 5; --rating-decimal: {{ rating_decimal }};"
            ></span>
            <span class="pakyuet-reviews__score">{{ pool.avg }}</span>
            <span class="pakyuet-reviews__count">· {{ pool.count }} 條評論</span>
          </p>
        {%- elsif product.metafields.reviews.rating.value != blank -%}
          {%- liquid
            assign rating_decimal = 0
            assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
            if decimal >= 0.3 and decimal <= 0.7
              assign rating_decimal = 0.5
            elsif decimal > 0.7
              assign rating_decimal = 1
            endif
          -%}
          <p class="pakyuet-reviews__summary">
            <span
              class="rating-star pakyuet-reviews__stars"
              style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
            <span class="pakyuet-reviews__score">{{ product.metafields.reviews.rating.value }}</span>
            {%- if product.metafields.reviews.rating_count != blank -%}
              <span class="pakyuet-reviews__count">· {{ product.metafields.reviews.rating_count }} 條評論</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_pool -%}
      <div id="pakyuet-reviews-mount" class="pakyuet-reviews__grid"></div>

      <script type="application/json" id="pakyuet-reviews-pool">{{ pool | json | replace: '</script', '<\/script' | replace: '</SCRIPT', '<\/SCRIPT' }}</script>
      <script>
        (function () {
          var mount = document.getElementById('pakyuet-reviews-mount');
          var script = document.getElementById('pakyuet-reviews-pool');
          if (!mount || !script) return;
          var pool;
          try { pool = JSON.parse(script.textContent); } catch (e) { return; }
          if (!pool || !Array.isArray(pool.reviews) || pool.reviews.length === 0) return;

          // Fisher-Yates 洗牌，每次加载随机取 6 条
          var arr = pool.reviews.slice();
          for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
          }
          var shown = arr.slice(0, 6);

          function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
              return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
          }

          var html = '';
          shown.forEach(function (r) {
            html += '<article class="pakyuet-review-card">';
            html += '<div class="pakyuet-review-card__stars">' + '★'.repeat(Math.min(5, Math.max(0, r.stars || 0))) + '</div>';
            if (r.title) { html += '<h3 class="pakyuet-review-card__title">' + esc(r.title) + '</h3>'; }
            if (r.body) { html += '<div class="pakyuet-review-card__body">' + esc(r.body) + '</div>'; }
            if (r.images && r.images.length) {
              html += '<div class="pakyuet-review-card__media">';
              r.images.slice(0, 3).forEach(function (img) {
                html += '<figure class="pakyuet-review-card__figure">';
                html += '<img src="' + esc(img) + '" alt="' + esc(r.author || '') + ' 的評價圖片" loading="lazy">';
                html += '</figure>';
              });
              html += '</div>';
            }
            if (r.author || r.location) {
              html += '<div class="pakyuet-review-card__author">' + esc(r.author || '') +
                (r.location ? '<span> · ' + esc(r.location) + '</span>' : '') + '</div>';
            }
            html += '</article>';
          });

          mount.innerHTML = html;
        })();
      </script>
    {%- else -%}
      <div id="pakyuet-reviews-anchor" class="pakyuet-reviews__anchor" data-product-id="{{ product.id }}">
        <p class="pakyuet-reviews__placeholder">{{ section.settings.placeholder_text }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .pakyuet-reviews.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .pakyuet-reviews.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "PAKYUET 评价区",
  "tag": "section",
  "class": "section pakyuet-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "顧客評價"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "无评价时的占位文案",
      "default": "評價功能即將上線"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上间距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下间距",
      "default": 36
    }
  ]
}
{% endschema %}
