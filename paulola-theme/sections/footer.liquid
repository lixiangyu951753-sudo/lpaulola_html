{%- comment -%}
  PAULOLA Footer（模組化版）
  可增刪/排序的區塊列（菜單欄/品牌資訊/文字欄）+ 支付圖標 + 版權/政策連結。
  區塊可在「主題編輯器 → 頁腳」中增刪與排序。
{%- endcomment -%}

{%- liquid
  assign year_now = 'now' | date: '%Y'
  assign footer_copyright = settings.footer_copyright | default: '© {year}, Paulola Jewelry 由 Shopify 技術支援' | replace: '{year}', year_now
  assign wa_text = settings.footer_whatsapp_text | default: '+852 9711 2975'
  assign wa_url = settings.footer_whatsapp_url | default: 'http://wa.me/85297112975'
-%}

<footer class="pk-footer" style="background: var(--pk-footer-bg); color: var(--pk-footer-text); padding-top: 36px;">
  <div class="pk-container">

    <!-- 區塊列（可在編輯器增刪/排序） -->
    {%- if section.blocks.size > 0 -%}
      <div class="pk-footer-grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              <details class="pk-footer-col pk-footer-details" open {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <summary class="pk-footer-heading pk-footer-summary">{{ block.settings.heading }}</summary>
                {%- endif -%}
                {%- assign linklist_menu = linklists[block.settings.menu] -%}
                {%- if linklist_menu.links.size > 0 -%}
                  <div class="pk-footer-links">
                    {%- for link in linklist_menu.links -%}
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </details>

            {%- when 'brand_information' -%}
              <details class="pk-footer-col pk-footer-brand pk-footer-details" open {{ block.shopify_attributes }}>
                <summary class="pk-footer-heading pk-serif pk-footer-summary" style="letter-spacing:0.05em;">PAULOLA TRADING LIMITED</summary>
                <div class="pk-footer-links">
                <p>
                  {%- assign addr = shop.address -%}
                  {%- if addr.address1 != blank -%}{{ addr.address1 }}{%- endif -%}
                  {%- if addr.address2 != blank -%}<br>{{ addr.address2 }}{%- endif -%}
                  {%- if addr.city != blank -%}<br>{{ addr.city }}{%- endif -%}
                </p>
                <p style="margin-top:6px;">电子邮箱: <a href="mailto:{{ shop.email }}" style="display:inline; margin:0;">{{ shop.email }}</a>{% if shop.phone != blank %}<br>電話: {{ shop.phone }}{% endif %}<br>
                WhatsApp: <a href="{{ wa_url }}" style="display:inline; margin:0;">{{ wa_text }}</a></p>
                <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:14px;">
                  {%- if settings.social_facebook != blank -%}
                    <a class="pk-social-icon" href="{{ settings.social_facebook }}" aria-label="Facebook" title="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"></path></svg></a>
                  {%- endif -%}
                  {%- if settings.social_instagram != blank -%}
                    <a class="pk-social-icon" href="{{ settings.social_instagram }}" aria-label="Instagram" title="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"></path></svg></a>
                  {%- endif -%}
                  {%- if settings.social_x != blank -%}
                    <a class="pk-social-icon" href="{{ settings.social_x }}" aria-label="X" title="X" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg></a>
                  {%- endif -%}
                  {%- if settings.social_threads != blank -%}
                    <a class="pk-social-icon" href="{{ settings.social_threads }}" aria-label="Threads" title="Threads" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.186 24h-.057c-3.58-.025-6.324-1.223-8.146-3.565C2.284 18.191 1.28 14.822 1.244 10.91v-.051C1.28 6.943 2.284 3.574 3.983 1.325 5.805-1.017 8.549-2.221 12.13-2.196c3.976.027 6.822 1.298 8.6 3.816 1.514 2.146 2.293 4.898 2.33 8.166v.448c-.107 5.885-2.292 9.78-6.384 11.483-1.105.458-2.83.411-4.49.283zm-.05-20.219c-2.845-.02-5.04.82-6.576 2.838-1.494 1.966-2.25 4.323-2.278 7.352.028 3.028.784 5.386 2.278 7.352 1.536 2.018 3.73 2.857 6.576 2.838 2.677-.02 4.693-.73 6.03-2.197 1.534-1.68 2.36-3.697 2.356-6.582v-.431c-.033-5.022-2.19-8.25-6.303-8.25h-.083zm3.127 13.075c.5.325.624.958.276 1.413-.358.467-.977.578-1.478.25-.07-.045-1.063-.663-2.125-.993-.184 1.113-.53 2.515-1.674 3.4-1.195.923-2.75 1.055-4.15.37-1.118-.551-1.886-1.435-2.27-2.617-.427-1.31-.432-2.765-.18-3.967 1.754.797 3.647 1.403 5.478 1.266 1.245-.093 2.417-.505 3.332-1.066l-.027-.018c-.057-.045-.113-.091-.17-.135-1.258-.975-2.468-1.415-3.595-1.308-1.077.103-1.865.585-2.346 1.426-.343.602-.302.827-.207.931.106.116.338.13.665.04.747-.206 1.673-.229 2.694-.072.05.444-.706 1.879-2.276 2.47-1.34.505-3.002.425-4.38-.66-.893-.703-1.531-1.752-1.756-3.022-.294-1.666.013-3.193.872-4.34 1.03-1.375 2.705-2.062 4.847-1.987 1.014.035 2.07.237 3.195.604.866-1.854 2.086-2.3 2.64-2.375.302.328.358.868.167 1.386-.14.386-.373.803-.57 1.118.705.3 1.293.68 1.782 1.136.349.325.358.885.022 1.224-.33.333-.86.356-1.217.046z"></path></svg></a>
                  {%- endif -%}
                </div>
                </div>
              </details>

            {%- when 'text' -%}
              <details class="pk-footer-col pk-footer-details" open {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <summary class="pk-footer-heading pk-footer-summary">{{ block.settings.heading }}</summary>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <div class="pk-footer-text pk-footer-links">{{ block.settings.subtext }}</div>
                {%- endif -%}
              </details>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- 底部：支付 + 版權 + 政策 -->
    <div class="pk-footer-bottom">
      <div>
        <h3 class="pk-footer-heading" style="margin-bottom:12px;">付款方式</h3>
        <div class="pk-payment-row">
          {%- assign pay_types = 'visa,master,maestro,american_express,apple_pay,google_pay,shopify_pay,paypal,unionpay,alipay,wechat_pay,klarna' | split: ',' -%}
          {%- for type in pay_types -%}
            {{ type | payment_type_svg_tag: class: 'pk-pay-icon' }}
          {%- endfor -%}
        </div>
      </div>
      <div class="pk-footer-legal">
        <p>{{ footer_copyright }}</p>
        <div class="pk-footer-policy">
          <a href="/policies/privacy-policy">隱私政策</a>
          <a href="/policies/terms-of-service">服務條款</a>
          <a href="/policies/contact-information">聯絡資訊</a>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "頁腳",
  "tag": "footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "下方區塊可在編輯器中增刪與排序。菜單欄的連結在「線上商店 → 導覽」中管理（預設使用 footer-shopping / footer-about / footer-support 三個菜單）。"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "菜單欄",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "欄目標題",
          "default": "快速連結"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "菜單"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "品牌資訊欄",
      "settings": [
        {
          "type": "paragraph",
          "content": "顯示公司名、地址、聯絡方式與社交圖標（社交連結在「主題設定 → 社交媒體」中填寫）。"
        }
      ]
    },
    {
      "type": "text",
      "name": "文字欄",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "標題"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "內容"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "頁腳"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pk-footer-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1.5fr; gap: 40px; padding-bottom: 40px; }
  .pk-footer-heading { color: #fff; font-size: 15px; font-weight: 600; margin: 0 0 16px; }
  .pk-footer a { color: var(--pk-footer-text); font-size: 14px; text-decoration: none; transition: color .2s ease; display: block; margin-bottom: 10px; }
  .pk-footer a:hover { color: var(--pk-gold); }
  .pk-footer-brand p { font-size: 14px; line-height: 1.8; margin: 0 0 6px; }
  .pk-footer-text { font-size: 14px; line-height: 1.8; }
  .pk-footer .pk-social-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin: 0; border: 1px solid #2A2520; border-radius: 50%; color: var(--pk-footer-text); transition: color .2s ease, border-color .2s ease; }
  .pk-footer .pk-social-icon:hover { border-color: var(--pk-gold); color: var(--pk-gold); }
  .pk-footer .pk-social-icon svg { width: 17px; height: 17px; fill: currentColor; }

  /* 折叠手风琴（参考 pakyuet）——桌面强制展开，手机可折叠 */
  .pk-footer-summary { list-style: none; cursor: default; }
  .pk-footer-summary::-webkit-details-marker { display: none; }
  .pk-footer-details { min-width: 0; }
  /* 桌面：强制展开、标题不可点击、隐藏 chevron */
  @media (min-width: 769px) {
    .pk-footer-summary { pointer-events: none; }
    .pk-footer-details:not([open]) > *:not(summary) { display: block !important; }
  }

  .pk-footer-bottom { border-top: 1px solid #2A2520; padding: 24px 0 32px; }
  .pk-payment-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .pk-pay-icon { height: 28px; width: auto; background: #fff; border-radius: 4px; }
  .pk-footer-legal { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .pk-footer-legal p { font-size: 13px; color: #8A8A8A; margin: 0; }
  .pk-footer-policy { display: flex; gap: 16px; }
  .pk-footer-policy a { display: inline; margin: 0; }

  @media (max-width: 768px) {
    .pk-footer-grid { grid-template-columns: 1fr; gap: 0; }
    .pk-footer-details { border-bottom: 1px solid #2A2520; }
    .pk-footer-details:first-child { border-top: 1px solid #2A2520; }
    .pk-footer-summary {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 0;
      margin-bottom: 0;
      cursor: pointer;
      user-select: none;
    }
    .pk-footer-summary::after {
      content: '';
      width: 8px; height: 8px;
      flex: none;
      border-right: 1.5px solid rgba(255,255,255,0.55);
      border-bottom: 1.5px solid rgba(255,255,255,0.55);
      transform: rotate(45deg);
      transition: transform 0.25s ease;
    }
    .pk-footer-details[open] > .pk-footer-summary::after { transform: rotate(-135deg); }
    .pk-footer-details[open] > .pk-footer-summary { margin-bottom: 12px; }
    /* 未展开时隐藏内容（压过全局规则） */
    .pk-footer-details:not([open]) > *:not(summary) { display: none !important; }
    .pk-footer-links { padding-bottom: 16px; }
    .pk-footer-legal { flex-direction: column; text-align: center; }
    .pk-footer-policy { justify-content: center; }
  }
{% endstylesheet %}

{% javascript %}
  // 手机端（≤768px）默认收起页脚手风琴；桌面端靠 <details open> 原生全展开
  (function () {
    if (window.__pkFooterInit) return;
    window.__pkFooterInit = true;
    var mq = window.matchMedia && window.matchMedia('(max-width: 768px)');
    if (!mq || !mq.matches) return;
    document.querySelectorAll('.pk-footer-details').forEach(function (d) {
      d.open = false;
    });
  })();
{% endjavascript %}
