{%- comment -%}
  PAULOLA Footer — 复刻 0.2.1 模板页脚：
  Newsletter + 購物/品牌/服務/品牌信息 四列 + 支付图标 + 版权/政策链接
{%- endcomment -%}

<footer class="pk-footer" style="background: var(--pk-footer-bg); color: var(--pk-footer-text); padding-top: 36px;">
  <div class="pk-container">

    <!-- Newsletter -->
    <div class="pk-newsletter">
      <div style="max-width: 560px; margin: 0 auto; text-align: center; padding: 0 0 40px;">
        <h3 class="pk-serif" style="color:#fff; font-size:22px; font-weight:600; margin:0 0 10px;">立即註冊成為會員以獲取最新資訊！</h3>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex; gap:10px; max-width:420px; margin: 0 auto; justify-content:center;">
            <input type="email" name="contact[email]" class="pk-newsletter-input" placeholder="電子郵件" aria-label="電子郵件" required>
            <button type="submit" class="pk-btn-gold" style="white-space:nowrap;">訂閱</button>
          </div>
        {% endform %}
      </div>
    </div>

    <!-- 四列内容 -->
    <div class="pk-footer-grid">
      <div>
        <h3 class="pk-footer-heading"><strong>購物</strong></h3>
        <a href="/collections/moissanite">莫桑石系列</a>
        <a href="/collections/daily-essentials">日常系列</a>
        <a href="{{ routes.collections_url }}">所有商品</a>
      </div>
      <div>
        <h3 class="pk-footer-heading"><strong>品牌</strong></h3>
        <a href="/pages/story">品牌故事</a>
        <a href="/pages/design">設計理念</a>
        <a href="/pages/material-care">材質與保養</a>
        <a href="/pages/styling-guide">佩戴指南</a>
        <a href="/blogs/inspiration">品牌靈感</a>
      </div>
      <div>
        <h3 class="pk-footer-heading"><strong>服務</strong></h3>
        <a href="/pages/faq">常見問題</a>
        <a href="/pages/shipping">配送政策</a>
        <a href="/pages/return-policy">退換政策</a>
        <a href="/pages/contact">聯絡我們</a>
      </div>
      <div class="pk-footer-brand">
        <h3 class="pk-footer-heading pk-serif" style="letter-spacing:0.05em;">PAULOLA TRADING LIMITED</h3>
        <p>
          {%- assign addr = shop.address -%}
          {%- if addr.address1 != blank -%}{{ addr.address1 }}{%- endif -%}
          {%- if addr.address2 != blank -%}<br>{{ addr.address2 }}{%- endif -%}
          {%- if addr.city != blank -%}<br>{{ addr.city }}{%- endif -%}
        </p>
        <p style="margin-top:6px;">电子邮箱: <a href="mailto:{{ shop.email }}" style="display:inline; margin:0;">{{ shop.email }}</a>{% if shop.phone != blank %}<br>電話: {{ shop.phone }}{% endif %}<br>
        WhatsApp: <a href="http://wa.me/85297112975" style="display:inline; margin:0;">+852 9711 2975</a></p>
        <div style="margin-top:14px;">
          <a class="pk-social-icon" href="https://www.facebook.com/share/1KWp86kvwC/" aria-label="Facebook" target="_blank" rel="noopener">Facebook</a>
          <a class="pk-social-icon" href="https://www.instagram.com/paulolajewelry_hk" aria-label="Instagram" target="_blank" rel="noopener">Instagram</a>
          <a class="pk-social-icon" href="https://x.com/Paulolajewelry" aria-label="X" target="_blank" rel="noopener">X</a>
          <a class="pk-social-icon" href="https://www.threads.com/@paulolajewelry_hk" aria-label="Threads" target="_blank" rel="noopener">Threads</a>
        </div>
      </div>
    </div>

    <!-- 底部：支付 + 版权 + 政策 -->
    <div class="pk-footer-bottom">
      <div>
        <h3 class="pk-footer-heading" style="margin-bottom:12px;">付款方式</h3>
        <div class="pk-payment-row">
          {%- assign pay_types = 'visa,master,maestro,american_express,apple_pay,google_pay,shopify_pay,paypal,unionpay,alipay,wechat_pay,klarna' | split: ',' -%}
          {%- for type in pay_types -%}
            {{ type | payment_type_svg_tag: class: 'pk-pay-icon' }}
          {%- endfor -%}
        </div>
      </div>
      <div class="pk-footer-legal">
        <p>© {{ 'now' | date: '%Y' }}, Paulola Jewelry 由 Shopify 技術支援</p>
        <div class="pk-footer-policy">
          <a href="/policies/privacy-policy">隱私政策</a>
          <a href="/policies/terms-of-service">服務條款</a>
          <a href="/policies/contact-information">聯絡資訊</a>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "頁腳（0.2.1 樣式）",
  "tag": "footer",
  "settings": [],
  "presets": [
    {
      "name": "頁腳（0.2.1 樣式）"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pk-newsletter { border-bottom: 1px solid #2A2520; margin-bottom: 36px; }
  .pk-newsletter-input { flex: 1; background: transparent; border: 1px solid rgba(255,255,255,0.3); color: #fff; padding: 12px 18px; border-radius: 999px; font-size: 14px; outline: none; }
  .pk-newsletter-input::placeholder { color: #8A8A8A; }
  .pk-newsletter-input:focus { border-color: var(--pk-gold); }

  .pk-footer-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1.5fr; gap: 40px; padding-bottom: 40px; }
  .pk-footer-heading { color: #fff; font-size: 15px; font-weight: 600; margin: 0 0 16px; }
  .pk-footer a { color: var(--pk-footer-text); font-size: 14px; text-decoration: none; transition: color .2s ease; display: block; margin-bottom: 10px; }
  .pk-footer a:hover { color: var(--pk-gold); }
  .pk-footer-brand p { font-size: 14px; line-height: 1.8; margin: 0 0 6px; }
  .pk-social-icon { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid #2A2520; border-radius: 50%; font-size: 11px; margin-right: 6px; }

  .pk-footer-bottom { border-top: 1px solid #2A2520; padding: 24px 0 32px; }
  .pk-payment-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .pk-pay-icon { height: 28px; width: auto; background: #fff; border-radius: 4px; }
  .pk-footer-legal { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .pk-footer-legal p { font-size: 13px; color: #8A8A8A; margin: 0; }
  .pk-footer-policy { display: flex; gap: 16px; }
  .pk-footer-policy a { display: inline; margin: 0; }

  @media (max-width: 768px) {
    .pk-footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
    .pk-footer-legal { flex-direction: column; text-align: center; }
    .pk-footer-policy { justify-content: center; }
  }
{% endstylesheet %}
