      "earrings": [[7, 93.1, 2], [7.25, 86.9, 7], [7.5, 81.9, 14.1], [7.75, 76.9, 18.4], [8, 71.1, 23.9], [8.25, 64.4, 28.5], [8.5, 61.4, 32.8], [8.75, 56.6, 37], [9, 52.6, 41.9], [9.25, 51.6, 44.9], [9.5, 47.4, 48.2], [9.75, 44.6, 49.6], [10, 42.4, 51.6]]
    };

    var video = document.querySelector('.pk-hero-video');
    var hero = document.querySelector('.pk-hero');

    /* 响应式视频：手机端（<768px）切换为竖屏 9:16 版
       注意：iOS Safari 上 load() 会重置播放状态，不能在 load() 后立即
       play()（元数据未就绪会失败）。只在实际切换源时才 load，并等
       loadeddata/canplay 就绪后再播放。 */
    var mq = window.matchMedia('(max-width: 768px)');
    function ensureMuted() {
      if (!video) return;
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('muted', '');
    }
    function applySrc() {
      if (!video || !video.dataset.desktopSrc) return;
      ensureMuted();
      var target = mq.matches && video.dataset.mobileSrc ? video.dataset.mobileSrc : video.dataset.desktopSrc;
      var cur = video.currentSrc || video.getAttribute('src') || '';
      if (cur.indexOf(target) === -1) {
        var started = false;
        function tryPlay() {
          if (started) return;
          started = true;
          var p = video.play();
          if (p && p.catch) p.catch(function () { started = false; });
        }
        video.src = target;
        video.load();
        if (video.readyState >= 1) { tryPlay(); }
        video.addEventListener('loadeddata', tryPlay, { once: true });
        video.addEventListener('canplay', tryPlay, { once: true });
      } else {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      }
    }
    if (mq.addEventListener) { mq.addEventListener('change', applySrc); } else if (mq.addListener) { mq.addListener(applySrc); }
    applySrc();

    /* iOS Safari 自动播放兜底：muted+playsinline 理应自动播，但个别版本
       或低电量模式会拦截；用户一旦点击/滑动页面就立即尝试恢复播放 */
    var userTouched = false;
    function retryPlay() {
      if (!video || video.paused === false) return;
      ensureMuted();
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }
    ['touchstart', 'touchend', 'click', 'scroll', 'keydown'].forEach(function (evt) {
      document.addEventListener(evt, function () {
        if (!userTouched) { userTouched = true; retryPlay(); }
      }, { passive: true, once: false });
    });
    /* 页面可见性恢复时也重试（从后台切回可能被暂停） */
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) retryPlay();
    });

    var dots = {};
    var cards = {};
    var cardEls = {};
    ITEMS.forEach(function (it) {
      dots[it.id] = document.getElementById('pkHotspot-' + it.id);
      var c = document.getElementById('pkIntro-' + it.id);
      cards[it.id] = c;
      if (c) {
        cardEls[it.id] = {
          eyebrow: c.querySelector('.pk-intro-eyebrow'),
          name: c.querySelector('.pk-intro-name'),
          desc: c.querySelector('.pk-intro-desc'),
          close: c.querySelector('.pk-intro-close')
        };
      }
    });
    var wasActive = {};
    var openCards = {};

    /* Catmull-Rom 样条插值：轨迹穿过全部标注点（手机版用独立 TRACKING_MOBILE） */
    function trackPos(item, t) {
      var fallback = { x: item.x, y: item.y };
      var pts = (mq.matches ? TRACKING_MOBILE : TRACKING)[item.id];
      if (!pts) return fallback;
      var P = [];
      for (var i = 0; i < pts.length; i++) {
        if (pts[i][1] !== null && pts[i][2] !== null) {
          P.push({ t: pts[i][0], x: pts[i][1], y: pts[i][2] });
        }
      }
      if (P.length === 0) return fallback;
      if (t <= P[0].t) return { x: P[0].x, y: P[0].y };
      if (t >= P[P.length - 1].t) return { x: P[P.length - 1].x, y: P[P.length - 1].y };
      if (P.length < 2) return { x: P[0].x, y: P[0].y };
      var seg = 0;
      for (var i = 0; i < P.length - 1; i++) {
        if (t >= P[i].t && t <= P[i + 1].t) { seg = i; break; }
      }
      var spanT = P[seg + 1].t - P[seg].t;
      var u = spanT > 0 ? (t - P[seg].t) / spanT : 0;
      var p0 = P[Math.max(0, seg - 1)];
      var p1 = P[seg];
      var p2 = P[seg + 1];
      var p3 = P[Math.min(P.length - 1, seg + 2)];
      if (seg === 0) p0 = p1;
      if (seg === P.length - 2) p3 = p2;
      function cr(v0, v1, v2, v3, uu) {
        var u2 = uu * uu, u3 = u2 * uu;
        return 0.5 * ((2 * v1) + (-v0 + v2) * uu + (2 * v0 - 5 * v1 + 4 * v2 - v3) * u2 + (-v0 + 3 * v1 - 3 * v2 + v3) * u3);
      }
      return { x: Math.min(100, Math.max(0, cr(p0.x, p1.x, p2.x, p3.x, u))), y: Math.min(100, Math.max(0, cr(p0.y, p1.y, p2.y, p3.y, u))) };
    }

    function openCard(item) {
      var e = cardEls[item.id];
      var c = cards[item.id];
      if (!c || !e) return;
      e.eyebrow.textContent = item.eyebrow;
      e.name.textContent = item.name;
      e.desc.textContent = item.desc;
      if (window.gsap) {
        gsap.killTweensOf(c);
        c.hidden = false;
        gsap.fromTo(c,
          { autoAlpha: 0, scale: 0.9, transformOrigin: 'left center' },
          { autoAlpha: 1, scale: 1, duration: 0.35, delay: 0.38, ease: 'power2.out', overwrite: true });
      } else {
        c.hidden = false;
      }
      openCards[item.id] = true;
    }
    function closeCard(item) {
      var c = cards[item.id];
      openCards[item.id] = false;
      if (!c || c.hidden) return;
      if (c.matches && c.matches(':hover')) {
        hovered = Math.max(0, hovered - 1);
        if (hovered === 0 && pausedByHover) {
          pausedByHover = false;
          if (video) video.play().catch(function () {});
        }
      }
      if (window.gsap) {
        gsap.killTweensOf(c);
        gsap.to(c, { autoAlpha: 0, scale: 0.9, duration: 0.16, ease: 'power1.in', overwrite: true, onComplete: function () { c.hidden = true; } });
      } else {
        c.hidden = true;
      }
    }
    function closeAllCards() {
      ITEMS.forEach(function (it) { closeCard(it); });
    }

    var hovered = 0;
    var pausedByHover = false;

    /* GSAP 依赖部分：等 gsap 就绪（defer 在 DOMContentLoaded 前执行）后启动 */
    function bootGsap() {
      if (!window.gsap || !video || !hero) return;
      var lines = {}, tips = {};
      ITEMS.forEach(function (it) {
        lines[it.id] = document.getElementById('pkLine-' + it.id);
        tips[it.id] = document.getElementById('pkTip-' + it.id);
      });
      var heroW = hero.offsetWidth, heroH = hero.offsetHeight;
      window.addEventListener('resize', function () { heroW = hero.offsetWidth; heroH = hero.offsetHeight; });
      var isMobile = window.matchMedia('(max-width: 768px)');
      var clampX = gsap.utils.clamp(8, 92);
      var clampY = gsap.utils.clamp(8, 92);

      /* GSAP quickTo 跟随器：宝石端(稳) / 圆点端(灵) / 卡片端(自然延迟) */
      var follows = {};
      ITEMS.forEach(function (it) {
        var gem = { x: 50, y: 50 }, dot = { x: 50, y: 50 }, card = { x: 50, y: 50 };
        follows[it.id] = {
          gem: gem, dot: dot, card: card,
          gemQx: gsap.quickTo(gem, 'x', { duration: 0.55, ease: 'power2.out' }),
          gemQy: gsap.quickTo(gem, 'y', { duration: 0.55, ease: 'power2.out' }),
          dotQx: gsap.quickTo(dot, 'x', { duration: 0.32, ease: 'power2.out' }),
          dotQy: gsap.quickTo(dot, 'y', { duration: 0.32, ease: 'power2.out' }),
          cardQx: gsap.quickTo(card, 'x', { duration: 0.6, ease: 'power2.out' }),
          cardQy: gsap.quickTo(card, 'y', { duration: 0.6, ease: 'power2.out' })
        };
      });

      function positionCard(item) {
        var c = cards[item.id];
        if (!c) return;
        var cardW = c.offsetWidth || 300;
        var cardH = c.offsetHeight || 130;
        if (isMobile.matches) {
          /* 移动端：卡片缩小后吸附在圆点旁（沿引导线方向偏移），随珠宝移动 */
          var f = follows[item.id];
          var mxPx = f.card.x / 100 * heroW;
          var myPx = f.card.y / 100 * heroH;
          var leftPx = mxPx + 14;
          var topPx = myPx - cardH / 2;
          if (leftPx + cardW > heroW - 8) leftPx = mxPx - cardW - 14;
          if (leftPx < 8) leftPx = 8;
          topPx = Math.max(8, Math.min(heroH - cardH - 8, topPx));
          c.style.left = leftPx + 'px';
          c.style.top = topPx + 'px';
          c.style.transform = 'none';
          return;
        }
        var f = follows[item.id];
        var mxPx = f.card.x / 100 * heroW;
        var myPx = f.card.y / 100 * heroH;
        var leftPx = mxPx + 28;
        var topPx = myPx - cardH / 2;
        if (leftPx + cardW > heroW - 12) leftPx = mxPx - cardW - 28;
        if (leftPx < 12) leftPx = 12;
        topPx = Math.max(12, Math.min(heroH - cardH - 12, topPx));
        c.style.left = leftPx + 'px';
        c.style.top = topPx + 'px';
        c.style.transform = 'none';
      }

      /* GSAP ticker 驱动 */
      function loop() {
        var t = video.currentTime;
        var activeItems = mq.matches ? ITEMS_MOBILE : ITEMS;
        activeItems.forEach(function (it) {
          var d = dots[it.id];
          if (!d) return;
          var active = t >= it.start && t < it.end;
          if (active) {
            var target = trackPos(it, t);
            var f = follows[it.id];
            var ln = lines[it.id], tp = tips[it.id];
            if (!wasActive[it.id]) {
              wasActive[it.id] = true;
              gsap.set(f.gem, { x: target.x, y: target.y });
              var ix = clampX(target.x + 11), iy = clampY(target.y - 9);
              gsap.set(f.dot, { x: ix, y: iy });
              gsap.set(f.card, { x: ix, y: iy });
              if (ln) {
                gsap.killTweensOf(ln);
                gsap.set(ln, { strokeDashoffset: 1 });
                gsap.to(ln, { strokeDashoffset: 0, duration: 0.4, ease: 'power2.out', overwrite: true });
                ln.classList.add('on');
              }
              if (tp) tp.classList.add('on');
              openCard(it);
            }
            f.gemQx(target.x); f.gemQy(target.y);
            var mx = clampX(f.gem.x + 11), my = clampY(f.gem.y - 9);
            f.dotQx(mx); f.dotQy(my);
            f.cardQx(mx); f.cardQy(my);
            d.style.left = f.dot.x + '%';
            d.style.top = f.dot.y + '%';
            if (ln) {
              ln.setAttribute('x1', (f.gem.x / 100 * heroW).toFixed(1));
              ln.setAttribute('y1', (f.gem.y / 100 * heroH).toFixed(1));
              ln.setAttribute('x2', (f.dot.x / 100 * heroW).toFixed(1));
              ln.setAttribute('y2', (f.dot.y / 100 * heroH).toFixed(1));
            }
            if (tp) {
              tp.setAttribute('cx', (f.gem.x / 100 * heroW).toFixed(1));
              tp.setAttribute('cy', (f.gem.y / 100 * heroH).toFixed(1));
            }
            if (!d.classList.contains('on')) d.classList.add('on');
          } else {
            if (d.classList.contains('on')) d.classList.remove('on');
            if (lines[it.id]) {
              lines[it.id].classList.remove('on');
              gsap.killTweensOf(lines[it.id]);
              gsap.set(lines[it.id], { strokeDashoffset: 1 });
            }
            if (tips[it.id]) tips[it.id].classList.remove('on');
            if (wasActive[it.id]) { wasActive[it.id] = false; closeCard(it); }
          }
        });
        activeItems.forEach(function (it) {
          if (openCards[it.id] && cards[it.id] && !cards[it.id].hidden) positionCard(it);
        });
      }
      gsap.ticker.add(loop);

      /* 点击圆点：切换该首饰卡片 */
      ITEMS.forEach(function (it) {
        var d = dots[it.id];
        if (d) d.addEventListener('click', function (e) {
          e.stopPropagation();
          if (openCards[it.id]) { closeCard(it); } else { openCard(it); }
        });
      });

      /* 卡片关闭按钮 */
      ITEMS.forEach(function (it) {
        var e = cardEls[it.id];
        if (e && e.close) e.close.addEventListener('click', function (ev) {
          ev.stopPropagation();
          closeCard(it);
        });
      });

      /* 悬停卡片：暂停视频；移开：恢复播放 */
      ITEMS.forEach(function (it) {
        var c = cards[it.id];
        if (!c) return;
        c.addEventListener('mouseenter', function () {
          hovered++;
          if (hovered === 1 && !video.paused) {
            pausedByHover = true;
            video.pause();
          }
        });
        c.addEventListener('mouseleave', function () {
          hovered = Math.max(0, hovered - 1);
          if (hovered === 0 && pausedByHover) {
            pausedByHover = false;
            video.play().catch(function () {});
          }
        });
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAllCards(); });
      document.addEventListener('click', function (e) {
        if (e.target.classList.contains('pk-hero-hotspot')) return;
        if (e.target.closest && e.target.closest('.pk-hero-intro')) return;
        var anyOpen = ITEMS.some(function (it) { return openCards[it.id]; });
        if (anyOpen) closeAllCards();
      });
    }
    if (window.gsap) { bootGsap(); } else { document.addEventListener('DOMContentLoaded', bootGsap); }
  })();
{% endjavascript %}
