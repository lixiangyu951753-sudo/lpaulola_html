{%- comment -%}
  PAULOLA Hero Video Section (GSAP 版)
  多圆点 + 引导线 + 四卡片 + 样条跟踪 + GSAP 动画（quickTo/ticker/线条绘制/卡片浮现）
  影片上傳到 設定→檔案→影片 後，在「主視覺影片」選擇即可
{%- endcomment -%}

{%- assign poster_url = 'hero-glorious.jpg' | asset_url -%}
{%- if section.settings.poster != blank -%}
  {%- assign poster_url = section.settings.poster | image_url: width: 1920 -%}
{%- endif -%}

{%- assign video_url = '' -%}
{%- if section.settings.video != blank -%}
  {%- assign video_url = section.settings.video.sources | first | map: 'url' | first | default: '' -%}
{%- endif -%}
{%- if video_url == blank -%}
  {%- assign video_url = 'video-jewelry-showcase-web.mp4' | file_url -%}
{%- endif -%}

{%- assign mobile_video_url = '' -%}
{%- if section.settings.mobile_video != blank -%}
  {%- assign mobile_video_url = section.settings.mobile_video.sources | first | map: 'url' | first | default: '' -%}
{%- endif -%}
{%- if mobile_video_url == blank -%}
  {%- comment -%} 店铺 Files 里的手机版视频真实托管地址 {%- endcomment -%}
  {%- assign mobile_video_url = 'https://cdn.shopify.com/videos/c/vp/2de7b8e9c93549b7928ff5dd78a1c43c/2de7b8e9c93549b7928ff5dd78a1c43c.HD-720p-1.6Mbps-91724913.mp4' -%}
{%- endif -%}

{%- comment -%}
  首饰介绍卡「查看商品」链接：戒指→rings 集合、项链→necklaces 集合（若无项链则 pendants 吊坠）、手链→bracelets、耳环→earrings
{%- endcomment -%}
{%- assign hero_ring_url = collections['rings'].url | default: '/collections/all' -%}
{%- assign hero_necklace_url = collections['necklaces'].url | default: '' -%}
{%- if hero_necklace_url == blank -%}
  {%- assign hero_necklace_url = collections['pendants'].url | default: '/collections/all' -%}
{%- endif -%}
{%- assign hero_bracelet_url = collections['bracelets'].url | default: '/collections/all' -%}
{%- assign hero_earrings_url = collections['earrings'].url | default: '/collections/all' -%}

<section class="pk-hero" id="pkHero">
  <video class="pk-hero-video" autoplay muted loop playsinline webkit-playsinline preload="auto" poster="{{ poster_url }}"
         data-desktop-src="{{ video_url }}" data-mobile-src="{{ mobile_video_url }}">
    <source src="{{ video_url }}" type="video/mp4">
  </video>

  <div class="pk-hero-content">
    {%- if section.settings.logo != blank -%}
      <img class="pk-hero-logo" src="{{ section.settings.logo | image_url: width: 600 }}" alt="PAULOLA" width="600" height="600">
    {%- else -%}
      <img class="pk-hero-logo" src="{{ 'PAULOLA.png' | asset_url }}" alt="PAULOLA" width="600" height="600">
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="pk-serif" style="color:#fff; font-size:clamp(30px,4vw,48px); font-weight:600; line-height:1.1; margin:0 0 20px; letter-spacing:-0.02em; text-shadow:0 2px 14px rgba(0,0,0,0.35);">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p style="color:rgba(255,255,255,0.9); font-size:16px; line-height:1.6; max-width:480px; margin:0 0 32px; text-shadow:0 1px 8px rgba(0,0,0,0.4);">{{ section.settings.subtext }}</p>
    {%- endif -%}
    <div class="flex-wrap" style="display:flex; flex-wrap:wrap; gap:16px;">
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="pk-btn-gold">{{ section.settings.btn_text }} →</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_link | default: routes.root_url }}" class="pk-btn-outline">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
  </div>

  <!-- 引导线层（圆点定位在宝石旁，细线+空心环指向宝石） -->
  <svg class="pk-leader" id="pkLeader" aria-hidden="true">
    <defs>
      <linearGradient id="pkGrad-champagne" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#EDD9A8" stop-opacity="0.95"/>
        <stop offset="45%" stop-color="#D9BE8C" stop-opacity="0.7"/>
        <stop offset="100%" stop-color="#C4A35A" stop-opacity="0.18"/>
      </linearGradient>
    </defs>
    <line id="pkLine-bracelet" class="pk-line" pathLength="1"></line>
    <line id="pkLine-necklace" class="pk-line" pathLength="1"></line>
    <line id="pkLine-ring" class="pk-line" pathLength="1"></line>
    <line id="pkLine-earrings" class="pk-line" pathLength="1"></line>
    <circle id="pkTip-bracelet" class="pk-line-tip" r="4.5"></circle>
    <circle id="pkTip-necklace" class="pk-line-tip" r="4.5"></circle>
    <circle id="pkTip-ring" class="pk-line-tip" r="4.5"></circle>
    <circle id="pkTip-earrings" class="pk-line-tip" r="4.5"></circle>
  </svg>

  <!-- 时间轴首饰热点（多圆点：重叠时段各首饰同时显示） -->
  <div class="pk-hero-hotspot" id="pkHotspot-bracelet"></div>
  <div class="pk-hero-hotspot" id="pkHotspot-necklace"></div>
  <div class="pk-hero-hotspot" id="pkHotspot-ring"></div>
  <div class="pk-hero-hotspot" id="pkHotspot-earrings"></div>

  <!-- 首饰介绍卡（每圆点各一张，吸附在各自圆点旁，可共存） -->
  <div class="pk-hero-intro" id="pkIntro-bracelet" hidden>
    <button class="pk-intro-close" aria-label="關閉">✕</button>
    <p class="pk-intro-eyebrow"></p>
    <h3 class="pk-intro-name pk-serif"></h3>
    <p class="pk-intro-desc"></p>
    <a class="pk-intro-link" href="{{ hero_bracelet_url }}">查看商品 →</a>
  </div>
  <div class="pk-hero-intro" id="pkIntro-necklace" hidden>
    <button class="pk-intro-close" aria-label="關閉">✕</button>
    <p class="pk-intro-eyebrow"></p>
    <h3 class="pk-intro-name pk-serif"></h3>
    <p class="pk-intro-desc"></p>
    <a class="pk-intro-link" href="{{ hero_necklace_url }}">查看商品 →</a>
  </div>
  <div class="pk-hero-intro" id="pkIntro-ring" hidden>
    <button class="pk-intro-close" aria-label="關閉">✕</button>
    <p class="pk-intro-eyebrow"></p>
    <h3 class="pk-intro-name pk-serif"></h3>
    <p class="pk-intro-desc"></p>
    <a class="pk-intro-link" href="{{ hero_ring_url }}">查看商品 →</a>
  </div>
  <div class="pk-hero-intro" id="pkIntro-earrings" hidden>
    <button class="pk-intro-close" aria-label="關閉">✕</button>
    <p class="pk-intro-eyebrow"></p>
    <h3 class="pk-intro-name pk-serif"></h3>
    <p class="pk-intro-desc"></p>
    <a class="pk-intro-link" href="{{ hero_earrings_url }}">查看商品 →</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero 影片",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "主視覺影片（先上傳到 設定→檔案→影片）"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "手機版主視覺影片（9:16 直式，上傳後選擇）"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "影片封面圖"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "主圖品牌 Logo（預設使用線上主題 PAULOLA 字標）"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "主標題",
      "default": "莫桑璀璨 真愛永恆"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "副標題",
      "default": "探索香港頂級莫桑石珠寶，每一件都經過嚴選認證"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "按鈕 1 文字",
      "default": "探索系列"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "按鈕 1 連結"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "按鈕 2 文字",
      "default": "了解更多"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "按鈕 2 連結"
    }
  ],
  "presets": [
    {
      "name": "Hero 影片"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pk-hero { position: relative; display: block; overflow: hidden; z-index: 1; }
  .pk-hero-video { display: block; width: 100%; height: auto; }
  .pk-hero-content { position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%); z-index: 2; max-width: 1160px; margin: 0 auto; padding: 0 24px; width: 100%; }

  /* 主圖品牌 Logo（深色字標反白，適配深色影片背景） */
  .pk-hero-logo { display: block; width: clamp(160px, 16vw, 240px); height: auto; margin-bottom: 18px; filter: brightness(0) invert(1); }

  .pk-btn-gold { display: inline-flex; align-items: center; gap: 8px; background: var(--pk-gold); color: var(--pk-dark); font-size: 15px; font-weight: 600; padding: 14px 32px; border-radius: 999px; text-decoration: none; transition: background .2s ease, transform .2s ease; }
  .pk-btn-gold:hover { background: var(--pk-gold-hover); transform: translateY(-1px); }
  .pk-btn-outline { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: #fff; font-size: 15px; font-weight: 500; padding: 14px 32px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.4); text-decoration: none; transition: border-color .2s ease, background .2s ease; }
  .pk-btn-outline:hover { border-color: var(--pk-gold); background: rgba(196,163,90,0.1); }

  /* 引导线层 */
  .pk-leader { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 4; pointer-events: none; }
  .pk-line { stroke: url(#pkGrad-champagne); stroke-width: 1.1; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; filter: drop-shadow(0 0 3px rgba(217,190,140,0.45)); transition: opacity .45s ease .05s; }
  .pk-line.on { opacity: 1; }
  .pk-line-tip { fill: none; stroke: #E8D5A4; stroke-width: 1.2; opacity: 0; filter: drop-shadow(0 0 4px rgba(232,213,164,0.8)); transition: opacity .45s ease .1s; }
  .pk-line-tip.on { opacity: 1; }

  /* 时间轴热点圆点 */
  .pk-hero-hotspot { position: absolute; z-index: 5; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--pk-gold); border: 2px solid #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transform: scale(.4); transition: opacity .35s ease, transform .35s cubic-bezier(.2,.8,.3,1.2), visibility .35s; will-change: transform, left, top; }
  .pk-hero-hotspot.on { opacity: 1; visibility: visible; transform: scale(1); }
  .pk-hero-hotspot::before { content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 1px solid rgba(196,163,90,0.7); animation: pk-ring 1.8s ease-out infinite; }
  .pk-hero-hotspot.on:hover { transform: scale(1.3); }
  @keyframes pk-ring { 0% { transform: scale(0.6); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }

  /* 首饰介绍卡（半透磨砂黑：底透视频 + 模糊玻璃感；hover 浮起 + 钻石反光微光） */
  .pk-hero-intro { position: absolute; z-index: 8; width: min(280px, calc(100vw - 48px)); background: rgba(12,12,14,0.5); backdrop-filter: blur(16px) saturate(1.35); -webkit-backdrop-filter: blur(16px) saturate(1.35); border: 1px solid rgba(232,213,164,0.28); border-radius: 10px; padding: 12px 34px 12px 14px; color: #fff; box-shadow: 0 10px 26px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.06); pointer-events: auto; overflow: hidden; transition: box-shadow .35s ease, background .35s ease, margin-top .35s ease, filter .35s ease; }
  .pk-hero-intro::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 25%, rgba(255,255,255,0.28) 48%, rgba(255,255,255,0.05) 58%, transparent 75%); opacity: 0; pointer-events: none; transition: opacity .4s ease; }
  .pk-hero-intro:hover { background: rgba(12,12,14,0.62); box-shadow: 0 20px 44px rgba(0,0,0,0.42), 0 0 26px rgba(232,213,164,0.22), inset 0 1px 0 rgba(255,255,255,0.1); margin-top: -4px; filter: brightness(1.08); }
  .pk-hero-intro:hover::after { opacity: 1; }
  .pk-hero-intro[hidden] { display: none; }
  .pk-intro-close { position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; border-radius: 50%; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 13px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .pk-intro-close:hover { background: var(--pk-gold); color: var(--pk-dark); }
  .pk-intro-eyebrow { color: var(--pk-gold); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; margin: 0 0 4px; }
  .pk-intro-name { font-size: 17px; font-weight: 600; margin: 0 0 6px; color: #fff; }
  .pk-intro-desc { font-size: 13px; line-height: 1.5; color: rgba(255,255,255,0.85); margin: 0; }
  .pk-intro-link { display: inline-flex; align-items: center; gap: 4px; color: var(--pk-gold); font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 8px; }
  .pk-intro-link:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .pk-hero-content { padding: 0 20px; }
    .pk-hero { height: 100vh; height: 100svh; }
    .pk-hero-video { width: 100%; height: 100%; object-fit: cover; }
    /* 移动端：隐藏引导线、介绍卡与跟踪圆点（视频干净无叠加） */
    .pk-leader { display: none; }
    .pk-hero-intro { display: none !important; }
    .pk-hero-hotspot { display: none; }
  }
{% endstylesheet %}

