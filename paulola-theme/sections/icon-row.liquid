{% schema %}
{
  "name": "產品分類圖標列",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "產品分類圖標列"
    }
  ]
}
{% endschema %}

{% stylesheet %}
:root {
  --pk-container-max: 1160px;
  --pk-background: #FFFFFF;
  --cf-cream: #f5ebd8;
  --cf-cream-soft: #faf2e0;
  --cf-cream-line: rgba(26,26,26,0.12);
  --cf-text: #1a1a1a;
  --cf-text-soft: #6b6b6b;
}
.cf-icons { padding: 56px 24px; background: var(--pk-background); }
.cf-icon-row { max-width: 920px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; }
.cf-icon-item { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 8px 12px; color: var(--cf-text); text-decoration: none; transition: opacity .2s ease; flex: 1; }
.cf-icon-item:hover { opacity: .65; }
.cf-icon-item svg { width: 44px; height: 44px; stroke: var(--cf-text); fill: none; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
.cf-icon-item .cf-icon-label { font-size: 14px; font-weight: 500; letter-spacing: 0.02em; }
@media (max-width: 768px) {
  .cf-icons { padding: 36px 16px; }
  .cf-icon-row { flex-wrap: wrap; gap: 18px 8px; justify-content: center; }
  .cf-icon-item { flex: 0 0 30%; }
}
{% endstylesheet %}
