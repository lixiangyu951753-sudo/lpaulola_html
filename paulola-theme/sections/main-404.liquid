{%- comment -%} PAULOLA 404 頁面 {%- endcomment -%}
<section class="pk-404 pk-section-pad">
  <div class="pk-container" style="text-align:center; max-width: 560px;">
    <h1 class="pk-404__title">404</h1>
    <p class="pk-404__text">{{ section.settings.text | default: '抱歉，找不到您要的頁面。' }}</p>
    <a href="{{ routes.root_url }}" class="pk-btn-gold">{{ section.settings.button_text | default: '回到首頁' }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 頁面",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "提示文字",
      "default": "抱歉，找不到您要的頁面。"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按鈕文字",
      "default": "回到首頁"
    }
  ],
  "presets": [
    {
      "name": "404 頁面"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.pk-404__title {
  font-family: var(--pk-font-serif);
  font-size: 72px;
  font-weight: 700;
  color: var(--pk-gold);
  margin: 0 0 8px;
  line-height: 1;
}
.pk-404__text {
  font-size: 15px;
  color: var(--pk-text-secondary);
  margin: 0 0 28px;
}
{% endstylesheet %}
