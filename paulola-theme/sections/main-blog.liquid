{%- comment -%} PAULOLA 部落格列表（可在後台 線上商店→部落格文章 管理） {%- endcomment -%}
<section class="pk-blog-page pk-section-pad">
  <div class="pk-container">
    <h1 class="pk-blog-page__title">{{ blog.title }}</h1>
    {%- paginate blog.articles by section.settings.posts_per_page -%}
      <div class="pk-blog-page__grid">
        {%- for article in blog.articles -%}
          <article class="pk-blog-page__card">
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" class="pk-blog-page__img-link">
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" width="800" height="500" loading="lazy">
              </a>
            {%- endif -%}
            <div class="pk-blog-page__body">
              <h2 class="pk-blog-page__card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="pk-blog-page__date">{{ article.published_at | date: '%Y-%m-%d' }}</p>
              <p class="pk-blog-page__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {{ paginate | default_pagination }}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "部落格列表",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "每頁文章數",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "部落格列表"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.pk-blog-page__title {
  font-family: var(--pk-font-serif);
  font-size: 32px;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 0 0 32px;
}
.pk-blog-page__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.pk-blog-page__card {
  background: #fff;
  border: 1px solid var(--pk-border);
  border-radius: 6px;
  overflow: hidden;
  transition: transform .25s ease, box-shadow .25s ease;
}
.pk-blog-page__card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(26,26,26,0.08); }
.pk-blog-page__img-link { display: block; aspect-ratio: 8/5; overflow: hidden; background: var(--cf-cream); }
.pk-blog-page__img-link img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.pk-blog-page__card:hover .pk-blog-page__img-link img { transform: scale(1.04); }
.pk-blog-page__body { padding: 22px; }
.pk-blog-page__card-title { font-family: var(--pk-font-serif); font-size: 18px; font-weight: 600; margin: 0 0 8px; line-height: 1.4; }
.pk-blog-page__card-title a { color: var(--pk-text-primary); text-decoration: none; }
.pk-blog-page__card-title a:hover { color: var(--pk-gold); }
.pk-blog-page__date { font-size: 12px; color: var(--pk-text-muted); letter-spacing: 0.08em; margin: 0 0 10px; }
.pk-blog-page__excerpt { font-size: 14px; color: var(--pk-text-secondary); line-height: 1.7; margin: 0; }
@media (max-width: 900px) {
  .pk-blog-page__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .pk-blog-page__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}
